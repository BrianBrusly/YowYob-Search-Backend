<?xml version="1.0" encoding="UTF-8"?>
<!--
 =====================================================================
  YOWYOB SEARCH - SHOP SERVICE
  - Agrégateur produits & marchands multi-plateformes e-commerce
  - Java 21
  - Spring Boot 3.4.0
  - REST + WebFlux (ingestion & exposition)
  - PostgreSQL + Redis
  - Elasticsearch (indexation produits)
  - Kafka (sync catalogues marchands)
  - Sécurité JWT / OAuth2
  - Résilience4j / Observabilité
 =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!--  PARENT : ROOT PROJECT                                    -->
    <!-- ========================================================= -->
    <parent>
        <groupId>com.yowyob</groupId>
        <artifactId>yowyob-search-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- ========================================================= -->
    <!--  IDENTITÉ DU SERVICE                                      -->
    <!-- ========================================================= -->
    <artifactId>yowyob-shop-service</artifactId>
    <name>YowYob Shop Service</name>
    <description>
        Microservice d’agrégation et de normalisation des produits,
        marchands et catalogues e-commerce (marketplaces, CMS, APIs externes),
        avec indexation, recherche, synchronisation temps réel et scoring.
    </description>

    <!-- ========================================================= -->
    <!--  DÉPENDANCES                                              -->
    <!-- ========================================================= -->
    <dependencies>

        <!-- ================= COMMON ================= -->
        <dependency>
            <groupId>com.yowyob</groupId>
            <artifactId>yowyob-common-service</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- SPRING BOOT CORE                                      -->
        <!-- ===================================================== -->

        <!-- REST APIs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebFlux (ingestion async, sync marchands) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- SÉCURITÉ                                              -->
        <!-- ===================================================== -->

        <!-- OAuth2 Resource Server (JWT) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- JWT bas niveau (custom tokens si besoin) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================================================== -->
        <!-- DONNÉES & CACHE                                       -->
        <!-- ===================================================== -->

        <!-- JPA / PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis (cache produits, prix, disponibilité) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- SEARCH / INDEXATION                                   -->
        <!-- ===================================================== -->

        <!-- Elasticsearch -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- MESSAGING / SYNC MARCHANDS                            -->
        <!-- ===================================================== -->

        <!-- Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- RÉSILIENCE & OBSERVABILITÉ                            -->
        <!-- ===================================================== -->

        <!-- Resilience4j -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- UTILITAIRES                                           -->
        <!-- ===================================================== -->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- DEV & TESTS                                          -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================================================= -->
    <!--  BUILD                                                   -->
    <!-- ========================================================= -->
    <build>
        <plugins>

            <!-- Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
